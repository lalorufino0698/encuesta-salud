# Copy this file to .env and complete the local credentials.
# AD: use a domain account, not a local administrator of the VM.
# With AD_DOMAIN set, AD_USERNAME is the short login name.
# Alternatively use a UPN in AD_USERNAME and leave AD_DOMAIN empty.
# Leave both username and password empty to use the Windows session.
AD_HOST=
AD_DOMAIN=
AD_USERNAME=
AD_PASSWORD=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=encuesta-salud

# Optional: overrides all DB_* values (useful for tests).
# DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/encuesta-salud?charset=utf8mb4

APP_HOST=127.0.0.1
APP_PORT=8000
UPLOAD_DIR=data/uploads
MAX_FILE_SIZE_MB=50
MAX_BATCH_FILES=250
PROCESSING_WORKERS=2
